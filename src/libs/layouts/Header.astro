---
import { Icon } from 'astro-icon/components'

import styles from './styles/Header.module.css'
---

<header class={styles.header}>
	<nav class={styles.navigation} aria-label='global'>
		<a class={styles.branding} href='/' aria-label='Brand'>iamgdev</a>

		<ul class={styles.menu}>
			<li>
				<a href='/projects' class={styles.cta_menu} aria-label='Nav Menu Item'>Project</a>
			</li>
			<li>
				<a href='/stacks' class={styles.cta_menu} aria-label='Nav Menu Item'>Stacks</a>
			</li>
			<li class='ms-auto'>
				<button id='toggleDarkMode' class={styles.cta_action}>
					<span class='sr-only'>Dark Theme</span>
					<Icon name='sun' class:list={[styles.icon, styles.icon_light]} />
					<Icon name='moon' class:list={[styles.icon, styles.icon_dark]} />
				</button>
			</li>
		</ul>
	</nav>
</header>

<script>
	function getCurrentTheme() {
		return localStorage.getItem('theme')
	}

	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement

		if (target.id === 'toggleDarkMode') {
			const toggleDarkModeEvent = new CustomEvent('theme-change', {
				detail: { theme: getCurrentTheme() === 'light' ? 'dark' : 'light' }
			})
			document.dispatchEvent(toggleDarkModeEvent)
		}
	})
</script>
