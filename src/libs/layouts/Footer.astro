---
import dayjs from 'dayjs'
import styles from './styles/Footer.module.css'
import { Icon } from 'astro-icon/components'
import socials from '@/configs/social'
---

<footer class={styles.footer}>
	<span class='inline-block text-sm'>
		© {dayjs().year()} Grafis Nuresa. All rights reserved.
	</span>

	<ul class={styles.socials}>
		{
			Object.keys(socials).map((social) => (
				<li>
					<a class={styles.link_social} href={socials[social as keyof typeof socials]}>
						<Icon name={social} class={styles.icon_social} />
					</a>
				</li>
			))
		}
	</ul>
</footer>
