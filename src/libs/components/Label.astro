---
import type { HTMLAttributes, HTMLTag } from 'astro/types'
import styles from './styles/Label.module.css'

type Props = (
	| {
			as: 'a'
			target: HTMLAttributes<'a'>['target']
			href: string
	  }
	| {
			as?: HTMLTag
	  }
) & {
	class?: string
	title: string
}
const { class: className, as: Stack = 'div', title, ...props }: Props = Astro.props
---

<Stack class:list={[className, styles.label]} {...props}>
	<slot name='icon' />
	<span>{title}</span>
</Stack>
