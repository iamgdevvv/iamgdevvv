---
import type { HTMLAttributes } from 'astro/types'

import styles from './styles/Button.module.css'

type Props = (
	| {
			as: 'a'
			target?: HTMLAttributes<'a'>['target']
			href: string
	  }
	| {
			as: 'button'
			type: HTMLAttributes<'button'>['type']
	  }
) & {
	id?: string
	class?: string
	title: string
	style?: 'pill' | 'button'
}
const { as: Stack = 'a', class: className, title, style = 'button', ...props }: Props = Astro.props
---

<Stack class:list={[className, styles.btn, style === 'pill' && 'rounded-full']} {...props}>
	<slot name='icon-before' />
	<span>{title}</span>
	<slot name='icon-after' />
</Stack>
