---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { HTMLAttributes, HTMLTag } from 'astro/types'
import { cn } from '@/utils'

type Props = (
	| {
			as: 'a'
			target: HTMLAttributes<'a'>['target']
			href: string
	  }
	| {
			as?: HTMLTag
	  }
) & {
	class?: string
	heading: string
	subheading: string
	imagePath: ImageMetadata
	altText?: string
}

const {
	as: Tag = 'a',
	class: className,
	heading,
	subheading,
	imagePath,
	altText,
	...props
}: Props = Astro.props
---

<Tag
	class={cn(
		className,
		'flex flex-col gap-y-3 rounded-2xl border border-border bg-primary-foreground ',
		'href' in props && 'transition-all hover:border-foreground/25 hover:shadow-sm'
	)}
	{...props}
>
	<Image
		src={imagePath}
		alt={altText}
		class='h-48 w-full rounded-2xl rounded-bl-none rounded-br-none object-cover'
		loading='eager'
	/>
	<div class='flex flex-col gap-y-0.5 px-5 py-4'>
		<h1 class='text-lg font-medium'>{heading}</h1>
		<h2 class='text-muted-foreground'>{subheading}</h2>
	</div>

	<slot />
</Tag>
