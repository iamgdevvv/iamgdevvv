---
import type { ImageMetadata } from 'astro'
import type { HTMLAttributes, HTMLTag } from 'astro/types'
import { Image } from 'astro:assets'
import dayjs from 'dayjs'
import styles from './styles/Card.module.css'

type Props = (
	| {
			as: 'a'
			target: HTMLAttributes<'a'>['target']
			href: string
	  }
	| {
			as?: HTMLTag
	  }
) & {
	class?: string
	heading: string
	subheading: string
	startDate: Date
	endDate?: Date
	endPresent?: boolean
	imagePath?: ImageMetadata
	altText?: string
	imageClass?: string
}
const {
	as: Stack = 'div',
	class: className,
	heading,
	subheading,
	startDate,
	endDate,
	endPresent = false,
	imagePath,
	altText,
	imageClass,
	...props
}: Props = Astro.props
---

<Stack class:list={[className, styles.card]} {...props}>
	{
		imagePath && (
			<Image
				src={imagePath}
				alt={altText || ''}
				class:list={[styles.card_image, imageClass]}
				loading='lazy'
			/>
		)
	}
	<div class={styles.card_inner}>
		<div class={styles.card_content}>
			<h3 class={styles.card_title}>{heading}</h3>
			<span class={styles.card_subtitle}>{subheading}</span>
			<span class={styles.card_date}>
				{dayjs(startDate).format('DD MMM YYYY')}
				{endPresent ? ' - Present' : endDate ? ` - ${dayjs(endDate).format('DD MMM YYYY')}` : ''}
			</span>
		</div>
		<slot />
	</div>
</Stack>
