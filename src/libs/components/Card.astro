---
import type { ImageMetadata } from 'astro'
import type { HTMLAttributes, HTMLTag } from 'astro/types'
import { Image } from 'astro:assets'
import dayjs from 'dayjs'
import { cn } from '@/utils'

type Props = (
	| {
			as: 'a'
			target: HTMLAttributes<'a'>['target']
			href: string
	  }
	| {
			as?: HTMLTag
	  }
) & {
	class?: string
	heading: string
	subheading: string
	startDate: Date
	endDate?: Date
	imagePath?: ImageMetadata
	altText?: string
	imageClass?: string
}
const {
	as: Tag = 'div',
	class: className,
	heading,
	subheading,
	startDate,
	endDate,
	imagePath,
	altText,
	imageClass,
	...props
}: Props = Astro.props
---

<Tag
	class={cn(
		className,
		'relative rounded-2xl border border-border bg-primary-foreground px-5 py-3',
		'href' in props && 'transition-all hover:border-foreground/25 hover:shadow-sm'
	)}
	{...props}
>
	{
		imagePath && (
			<Image
				src={imagePath}
				alt={altText}
				class={cn('mb-3 md:absolute md:mb-0', imageClass)}
				loading='eager'
			/>
		)
	}
	<div class='flex flex-col gap-y-1.5'>
		<div class='flex flex-col gap-y-0.5'>
			<h1 class='text-lg font-medium'>{heading}</h1>
			<h2 class='text-muted-foreground'>{subheading}</h2>
			<h2 class='text-muted-foreground'>
				{dayjs(startDate).toISOString()}
				{endDate ? ` - ${dayjs(endDate).toISOString()}` : ''}
			</h2>
		</div>
		<slot />
	</div>
</Tag>
