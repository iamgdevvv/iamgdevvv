---
import Button from '../components/Button.astro'
import styles from './styles/Contact.module.css'
---

<head>
	<script
		is:inline
		src={`https://www.google.com/recaptcha/api.js?render=${import.meta.env.PUBLIC_GOOGLE_RECAPTCHA_SITE}`}
	></script>
</head>
<div id='message' class={styles.message}></div>

<!-- action={`https://formcarry.com/s/${import.meta.env.FORMCARRY_ID}`}
method='POST' -->
<form id='contact-form' class={styles.form}>
	<div class:list={[styles.field, styles.field_half]}>
		<label class={styles.label}>Name</label>
		<input name='Name' type='text' placeholder='Enter your name' required />
	</div>

	<div class:list={[styles.field, styles.field_half]}>
		<label class={styles.label}>Email</label>
		<input name='Email' type='email' placeholder='Enter your email' required />
	</div>

	<div class={styles.field}>
		<label class={styles.label}>Organization</label>
		<input name='Organization' type='text' placeholder='Enter your organization' required />
	</div>

	<div class={styles.field}>
		<label class={styles.label}>Purposes</label>
		<select name='Purposes' required>
			<option value='Collaborate'>Collaborate 🤝</option>
			<option value='Disccuss'>Disccuss 🤔</option>
			<option value='Hire me'>Hire me 🚀</option>
			<option value='Other'>Other 🧩</option>
		</select>
	</div>

	<div class:list={[styles.field, styles.field_message]}>
		<label class={styles.label}>Message</label>
		<textarea
			name='Message'
			required
			placeholder="Hi there, I'm reaching out to discuss the potential development of a design system for our products at Company X. Could you let me know if you're available to discuss this further, and perhaps suggest a timeframe for when we could start working on it together?"
		></textarea>
	</div>
	<div class={styles.action}>
		<Button as='button' type='submit' title='Get in touch' class={styles.cta_submit} />
	</div>
</form>

<script>
	import { ContactSchema } from '@/utils'

	const el_form = document.getElementById('contact-form') as HTMLFormElement
	const el_message = document.getElementById('message') as HTMLDivElement
	const els_input = document.querySelectorAll<HTMLInputElement>('[name]')

	els_input.forEach((el) => {
		el.addEventListener('blur', (e) => {
			const isValid = ContactSchema.shape[
				el.getAttribute('name') as keyof typeof ContactSchema.shape
			].safeParse((e.target as HTMLInputElement).value)

			if (isValid.success) {
				el.removeAttribute('aria-invalid')
			} else {
				el.setAttribute('aria-invalid', 'true')
			}
		})
	})

	if (el_form) {
		el_form.addEventListener('submit', async (event) => {
			event.preventDefault()

			try {
				if (import.meta.env.PROD) {
					const fetchRecaptcha = await fetch('/api/recaptcha', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json'
						},
						body: JSON.stringify({
							recaptcha: import.meta.env.PUBLIC_GOOGLE_RECAPTCHA_SITE
						})
					})

					const responseRecaptcha = await fetchRecaptcha.json()

					if (!responseRecaptcha.success) {
						throw new Error('Recaptcha invalid!')
					}
				}

				const formData = new FormData(event.target as HTMLFormElement)

				const payload = Object.fromEntries(formData.entries())

				const contactParse = ContactSchema.safeParse(payload)

				if (!contactParse.success) {
					const messageError = contactParse.error.issues
						.map((error) => {
							if (error.path.length === 0) {
								return error.message
							}

							return error.path
								.map((path) => {
									document.querySelector(`[name="${path}"]`)?.setAttribute('aria-invalid', 'true')

									return `${path}: ${error.message}`
								})
								.join(', ')
						})
						.join(', ')

					throw new Error(`Error!<br /><pre>${messageError}</pre>`)
				}

				const fetchFormCarry = await fetch(
					`https://formcarry.com/s/${import.meta.env.PUBLIC_FORMCARRY_ID}`,
					{
						method: 'POST',
						headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
						body: JSON.stringify(contactParse.data)
					}
				)

				const responseFormCarry = await fetchFormCarry.json()

				if (!fetchFormCarry.ok || responseFormCarry.code !== 200) {
					throw new Error(responseFormCarry.message || 'Submission Error!')
				}

				if (el_message) {
					el_message.setAttribute('data-show', 'true')
					el_message.setAttribute('data-invalid', 'false')
					el_message.insertAdjacentHTML(
						'beforeend',
						`Success!<br />Thanks for your message! Redirecting...`
					)

					setTimeout(() => {
						el_message.removeAttribute('data-show')
						el_message.removeAttribute('data-invalid')
						el_message.innerHTML = ''
					}, 2000)
				}

				location.replace(
					`${location.origin}/thank-you?${new URLSearchParams(contactParse.data).toString()}`
				)
			} catch (error) {
				console.log('error')
				if (el_message) {
					el_message.setAttribute('data-show', 'true')
					el_message.setAttribute('data-invalid', 'true')
					el_message.insertAdjacentHTML('beforeend', error as string)

					setTimeout(() => {
						el_message.removeAttribute('data-show')
						el_message.removeAttribute('data-invalid')
						el_message.innerHTML = ''
					}, 2000)
				}
			}
		})
	}
</script>
