---
import { Icon } from 'astro-icon/components'

import PageLayout from '@templates/BaseTemplate.astro'
import StackSection from '@components/StackSection.astro'
import Button from '@components/Button.astro'

import { languages, frontends, backends, others } from '@/configs/stacks'
---

<PageLayout meta={{ title: 'Home' }}>
	<div class='w-full'>
		<Button as='a' title='Back' href='/' style='button'>
			<Icon name='back' slot='icon-before' />
		</Button>

		<div class='mt-5 flex w-full flex-col gap-y-6'>
			<div>
				<h1>Stacks</h1>
				<p>Some technologies that I use</p>
			</div>

			<StackSection title='Language' stacks={languages} />
			<StackSection title='Frontend' stacks={frontends} />
			<StackSection title='Backend' stacks={backends} />
			<StackSection title='Others' stacks={others} />
		</div>
	</div>
</PageLayout>
